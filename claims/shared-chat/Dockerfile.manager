FROM docker.io/library/node:24.22.3-bookworm-slim@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54
WORKDIR /app
COPY workspace-manager.mjs manager-server.mjs duplex.mjs ./
RUN install -d -m 0755 /run/chat-manager && install -d -m 0700 /var/lib/chat-manager
ENTRYPOINT ["node","manager-server.mjs"]
